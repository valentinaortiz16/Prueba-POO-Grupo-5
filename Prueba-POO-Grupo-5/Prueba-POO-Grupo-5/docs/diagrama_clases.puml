
# Diagrama de clases UML

```plantuml
@startuml

class Main {
  + main(args: String[]) : void
  - mostrarMenu() : void
  - ejecutar(opcion: int) : void
  - leerEntero(mensaje: String) : int
  - leerTexto(mensaje: String) : String
}

class Organizacion {
  - empleados : ArrayList<Empleado>
  - departamentos : ArrayList<Departamento>
  - cargos : ArrayList<Cargo>
  - director : Empleado
  + registrarEmpleado(id, nombre, departamento, cargo) : Empleado
  + designarDirector(id) : void
  + asignarSupervisor(idEmp, idSup) : void
  + subordinadosDirectos(id) : List<Empleado>
  + nivel(id) : int
  + cadenaSupervisores(id) : List<Empleado>
  + ancestroComun(a, b) : Empleado
  + listarEmpleados() : List<Empleado>
  + empleadosPorCargo(cargo) : List<Empleado>
}

class Departamento {
  - nombre : String
  - empleados : ArrayList<Empleado>
  + agregarEmpleado(e) : void
}

class Cargo {
  - nombre : String
  - salarioBase : double
  - empleados : ArrayList<Empleado>
}

class Empleado {
  - id : int
  - nombre : String
  - cargo : Cargo
  - departamento : Departamento
  - supervisor : Empleado
  - subordinados : ArrayList<Empleado>
  + setSupervisor(s) : void
  + calcularNivel() : int
}

Main --> Organizacion

Organizacion "1" o-- "*" Empleado
Organizacion "1" o-- "*" Departamento
Organizacion "1" o-- "*" Cargo

Departamento "1" -- "*" Empleado
Cargo "1" -- "*" Empleado

Empleado "*" --> "0..1" Empleado : supervisor
Empleado "1" -- "*" Empleado : subordinados

@enduml
```
